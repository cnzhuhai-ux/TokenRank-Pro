# 复制为 wrangler.toml 并填入你的资源 id：cp wrangler.toml.example wrangler.toml
# 部署步骤见 ../README.md「服务端部署」。

name = "tokenrank-api"
main = "src/worker.js"
compatibility_date = "2026-09-01"

# ── 备案域名接入（二选一）─────────────────────────────
# 方式 A（推荐）：Worker Custom Domain —— 域名 DNS 托管在 Cloudflare 时，
# 取消注释并填你的子域（如 rank-api.example.com），wrangler deploy 会自动
# 建 DNS + 证书，无需额外反代：
# routes = [
#   { pattern = "rank-api.example.com", custom_domain = true }
# ]
# 方式 B：域名在国内服务器/CDN 上，用 nginx 反代到 workers.dev 地址，
# 或 CDN 回源 —— 不需要动本文件，但多一跳延迟。

[[d1_databases]]
binding = "DB"
database_name = "tokenrank"
# npx wrangler d1 create tokenrank 后把输出里的 database_id 填进来
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[triggers]
crons = ["*/5 * * * *"]

[vars]
# 若用国内 CDN/服务器反代到 workers.dev（回源 Host 是 workers.dev），
# 必须配置此项，否则接入命令等会显示 workers.dev 域名：
# PUBLIC_BASE_URL = "https://<你的域名>"
# 浏览器直连时才需要；逗号分隔的允许来源，不要用 *。小程序和命令行同步器不需要 CORS。
# CORS_ORIGIN = "https://<你的域名>"
WX_APPID = "wx0000000000000000"
# 消息模板未申请时保持关闭，不能用占位 ID。详见 docs/reminders.md。
WX_REMINDERS_ENABLED = "0"
# 申请通过后，WX_REMINDER_TEMPLATES 填入真实模板 ID 和关键词映射，建议用 secret put。
# 程序不预设模板编号，也不会把一次授权当成永久订阅。
# 常用用户入口默认免费。当前仅预留激励入口；启用 rewarded 前必须接入
# 客户端播放流程和服务端授权核验，否则名单接口会拒绝访问。
# INSIGHTS_AUDIENCE_ACCESS = "free"
# 小程序码默认打开正式版。仅体验环境可改为 trial / develop；由服务端固定，客户端不能覆盖。
# WX_CODE_ENV_VERSION = "release"
# ⚠️ 联调开关：未配置 WX_APPSECRET 时，允许 code 直接作为 openid 登录（任何人可冒充）。
# 生产环境必须：wrangler secret put WX_APPSECRET 并把下面这行删掉。
ALLOW_DEV_LOGIN = "1"

# ── 飞书机器人（可选；配置见 docs/feishu.md）──────────────────────
# 在飞书开放平台创建「企业自建应用」并添加机器人能力后填入。
# 未配置 FEISHU_APP_ID/FEISHU_APP_SECRET 时 /feishu/event 直接忽略所有事件。
# HTTP 回调必须配置 FEISHU_VERIFICATION_TOKEN 或 FEISHU_ENCRYPT_KEY 之一，
# 两者都没有时所有事件都会被拒绝（Node 长连接模式不受影响）。
# FEISHU_APP_ID = "cli_xxxxxxxxxxxxxxxx"
# FEISHU_VERIFICATION_TOKEN = "事件订阅的 Verification Token（事件加密页可查）"
# 若事件订阅开启「加密策略」，还需配置 Encrypt Key（回调改校验 X-Lark-Signature）：
# FEISHU_ENCRYPT_KEY = "xxxxxxxxxxxxxxxx"

# 生产环境额外执行（密钥不入库不入 git）：
#   npx wrangler secret put WX_APPSECRET
#   npx wrangler secret put FEISHU_APP_SECRET
# 并删除上面的 ALLOW_DEV_LOGIN
# 数据库迁移（老库升级）：npx wrangler d1 execute tokenrank --remote --file=migrations/0018_feishu.sql
