@import "../../styles/profile-editor.wxss";

.page { padding: 0 var(--space-page, 16px) 32px; }
.period-tabs { margin: 0 calc(0px - var(--space-page, 16px)); }
.period-tabs .tab { border-radius: 0; background: transparent; line-height: 1.5; word-break: keep-all; }
.period-tabs .tab::after { top: auto; right: auto; border: none; border-radius: 0; transform: none; }
.section-title { font-size: var(--font-heading, 17px); font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.note { font-size: var(--font-caption, 12px); color: var(--text-secondary); line-height: 1.7; margin-top: 12px; overflow-wrap: anywhere; }
.loading-state { padding: var(--space-section, 24px) 0; }
.loading-number { height: 56px; width: 60%; }
.error-note { padding: var(--space-section, 24px) 0; color: var(--danger); font-size: var(--font-detail, 14px); line-height: 1.7; overflow-wrap: anywhere; }
.error-note .btn { width: 100%; margin-top: 16px; }

.usage-hero { padding: var(--space-section, 24px) 0; }
.hero-label { color: var(--text-secondary); font-size: var(--font-detail, 14px); }
.hero-number { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 6px; margin-top: 8px; color: var(--amount); font-size: 48px; font-weight: 400; line-height: 1.25; overflow-wrap: anywhere; }
.hero-unit { font-size: 24px; font-weight: 400; }
.hero-tail { color: var(--text-secondary); font-size: var(--font-detail, 14px); }
.exact { margin-top: 8px; color: var(--text-secondary); font-size: var(--font-detail, 14px); overflow-wrap: anywhere; }
.credits-summary { margin-top: 12px; }
.credits-number { margin-top: 0; }
.credits-note { margin-top: 4px; color: var(--text-secondary); font-size: var(--font-caption, 12px); line-height: 1.6; overflow-wrap: anywhere; }
.range, .cost-note { margin-top: 12px; color: var(--text-secondary); font-size: var(--font-caption, 12px); line-height: 1.7; overflow-wrap: anywhere; }
.cost-note { margin-top: 6px; }
.metrics { display: flex; flex-wrap: wrap; gap: 8px var(--space-section, 24px); margin-top: 16px; }
.metric { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; min-width: 0; }
.metric-label, .metric-unit { color: var(--text-secondary); font-size: var(--font-caption, 12px); }
.metric-value { font-size: var(--font-heading, 17px); font-weight: 400; overflow-wrap: anywhere; }
.usage-share { margin-top: 20px; }
.share-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.share-actions .btn { flex: 1 1 120px; min-width: 0; margin: 0; font-size: var(--font-body, 15px); }
.share-feedback { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin-top: 4px; color: var(--danger); font-size: var(--font-caption, 12px); line-height: 1.7; }
.share-feedback > text { flex: 1 1 160px; min-width: 0; overflow-wrap: anywhere; }
.share-feedback .text-button { flex: none; margin: 0; padding: 0 4px; min-width: var(--touch-size, 44px); }

.connection-section { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding: 16px 0; border-top: 1rpx solid var(--separator); }
.connection-copy { flex: 1 1 144px; min-width: 0; }
.connection-section .sync-text { margin-top: 4px; }
.connection-section .btn { flex: 0 1 auto; min-width: 104px; max-width: 100%; margin: 0; font-size: var(--font-body, 15px); }
.sync-text { color: var(--text-secondary); font-size: var(--font-detail, 14px); line-height: 1.7; overflow-wrap: anywhere; }
.history-entries { display: flex; flex-wrap: wrap; gap: 0 16px; border-top: 1rpx solid var(--separator); }
.history-entries button { display: flex; flex: 1 1 calc(50% - 8px); align-items: center; justify-content: space-between; gap: 8px; min-width: 0; min-height: 56px; box-sizing: border-box; padding: 10px 0; margin: 0; border-radius: 0; background: transparent; color: var(--text); font-size: var(--font-body, 15px); font-weight: 400; line-height: 1.5; text-align: left; }
.history-entries button::after { border: none; }
.entry-label { min-width: 0; overflow-wrap: anywhere; }
.menu-arrow { flex: none; color: var(--text-muted); font-size: var(--font-title, 22px); }

.section { border-top: 1rpx solid var(--separator); }
.section-toggle { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; min-height: 72px; box-sizing: border-box; padding: 12px 0; margin: 0; border-radius: 0; background: transparent; color: var(--text); font-weight: 400; line-height: 1.5; text-align: left; }
.section-toggle::after { border: none; }
.section-toggle[disabled] { background: transparent; color: var(--text-secondary); }
.section-copy { flex: 1; min-width: 0; }
.section-meta { margin-top: 4px; color: var(--text-secondary); font-size: var(--font-caption, 12px); line-height: 1.6; overflow-wrap: anywhere; }
.section-action { flex: none; color: var(--link); font-size: var(--font-detail, 14px); }
.section-toggle[disabled] .section-action { color: var(--text-muted); }
.section-content { padding-bottom: var(--space-section, 24px); }
.profile-content { padding-top: 0; }

.date-stepper { display: flex; align-items: stretch; gap: 8px; }
.date-step { display: flex; flex: none; align-items: center; justify-content: center; min-width: var(--touch-size, 44px); min-height: var(--touch-size, 44px); box-sizing: border-box; padding: 8px; margin: 0; border-radius: 4px; background: var(--surface-muted); color: var(--link); font-size: var(--font-detail, 14px); font-weight: 400; line-height: 1.5; }
.date-step::after { border: none; }
.date-step[disabled] { background: var(--surface-muted); color: var(--text-muted); }
.date-picker { flex: 1; min-width: 0; }
.date-picker-label { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0 8px; min-height: var(--touch-size, 44px); box-sizing: border-box; padding: 4px; border-bottom: 1rpx solid var(--separator-strong); color: var(--text); font-size: var(--font-detail, 14px); text-align: center; }
.date-picker-label > text { overflow-wrap: anywhere; }
.date-picker-hint { color: var(--link); font-size: var(--font-caption, 12px); }
.selected-day { margin-top: 16px; }
.selected-day-label { color: var(--text-secondary); font-size: var(--font-caption, 12px); }
.selected-day-number { margin-top: 4px; color: var(--amount); font-size: var(--font-title, 22px); line-height: 1.5; overflow-wrap: anywhere; }
.selected-day-unit { color: var(--text-secondary); font-size: var(--font-caption, 12px); }
.selected-day-status { margin-top: 4px; color: var(--text-secondary); font-size: var(--font-body, 15px); }
.chart-caption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; margin: 16px 0 12px; color: var(--text-secondary); font-size: var(--font-caption, 12px); }
.chart { display: flex; align-items: flex-end; height: 100px; border-bottom: 1rpx solid var(--separator-strong); }
.bar-slot { display: flex; flex: 1; align-items: flex-end; justify-content: center; height: 100%; box-sizing: border-box; padding: 0 2px; }
.bar { width: 100%; max-width: 22px; min-height: 2px; border-radius: 2px 2px 0 0; background: var(--amount); opacity: .35; }
.bar-zero { background: var(--separator-strong); }
.bar-selected .bar { opacity: 1; }
.axis { display: flex; justify-content: space-between; padding-top: 6px; color: var(--text-secondary); font-size: var(--font-caption, 12px); }

.text-button { display: flex; align-items: center; justify-content: center; min-width: var(--touch-size, 44px); min-height: var(--touch-size, 44px); box-sizing: border-box; padding: 8px 0; margin: 0; background: transparent; color: var(--link); font-size: var(--font-detail, 14px); font-weight: 400; line-height: 1.5; }
.text-button::after { border: none; }
.analysis-entry { display: flex; justify-content: flex-end; }
.analysis-entry .text-button { margin: 0; }
.breakdown-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 12px; }
.breakdown-label { color: var(--text-secondary); font-size: var(--font-detail, 14px); }
.tools-share { margin: 0; }
.model-label { margin-top: var(--space-section, 24px); }
.detail-row { margin-top: 16px; }
.detail-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; }
.detail-name { min-width: 0; font-size: var(--font-detail, 14px); overflow-wrap: anywhere; }
.detail-number { color: var(--text-secondary); font-size: var(--font-caption, 12px); overflow-wrap: anywhere; }
.track { height: 3px; margin-top: 6px; background: var(--separator); }
.fill { height: 100%; background: var(--amount); }
.tool-fill { background: var(--text-secondary); }
.all-details { width: 100%; margin-top: 8px; }
.cache-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding: 12px 0; color: var(--text-secondary); font-size: var(--font-detail, 14px); }
.cache-row + .cache-row { border-top: 1rpx solid var(--separator); }
.cache-row > text { min-width: 0; overflow-wrap: anywhere; }

.account-section { padding: var(--space-section, 24px) 0; border-top: 1rpx solid var(--separator); }
.ranking-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: var(--touch-size, 44px); margin-bottom: 8px; }
.ranking-row switch { display: flex; flex: none; align-items: center; min-height: var(--touch-size, 44px); }
.menu-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; min-height: 56px; box-sizing: border-box; padding: 12px 0; margin: 0; border-top: 1rpx solid var(--separator); border-radius: 0; background: transparent; color: var(--text); font-size: var(--font-body, 15px); font-weight: 400; line-height: 1.5; text-align: left; }
.menu-item::after { border: none; }
.menu-item > text { min-width: 0; overflow-wrap: anywhere; }
.account-delete { color: var(--danger); }

@media (max-width: 340px) {
  .date-stepper { flex-wrap: wrap; }
  .date-picker { flex: 0 0 100%; order: -1; }
  .date-step { flex: 1; }
  .history-entries { column-gap: 12px; }
  .history-entries button { flex-basis: calc(50% - 6px); }
}
