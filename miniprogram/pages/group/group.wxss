@import "../../styles/profile-editor.wxss";
@import "../../styles/leaderboard.wxss";
.page { padding-bottom: calc(160px + env(safe-area-inset-bottom)); }

/* 群名和单行同步入口，周期之后直接展示排名。 */
.hero { padding: 12px var(--space-page) 0; }
.hero-top { display: flex; align-items: center; gap: 8px; }
.hero-text { flex: 1; min-width: 0; }
.hero-name { font-size: var(--font-heading); font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.hero-sub { margin-top: 3px; color: var(--text-muted); font-size: var(--font-caption); line-height: 1.5; }
.hero-top .rename-btn, .hero-top .overview-shortcut { flex: none; width: auto; min-width: var(--touch-size); min-height: var(--touch-size); margin: 0; padding: 0 4px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; background: transparent; color: var(--link); font-size: var(--font-detail); font-weight: 400; line-height: 1.5; border-radius: 0; }
.rename-btn::after, .overview-shortcut::after, .sync-strip::after, .text-action::after, .overview-link::after, .tab::after { border: none; }
.hero .sync-strip { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; min-height: var(--touch-size); margin: 0; padding: 0; box-sizing: border-box; border: none; border-radius: 0; background: transparent; color: var(--text-muted); font-size: var(--font-caption); font-weight: 400; line-height: 1.5; text-align: left; }
.sync-main { flex: 1; display: flex; align-items: center; gap: 6px; min-width: 0; }
.sync-text { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.sync-action { flex: none; color: var(--link); }
.status-dot { width: 5px; height: 5px; background: var(--primary); }
.status-pending .status-dot, .status-stale .status-dot { background: var(--danger); }
.connection-panel { padding: 12px 0 var(--space-section); }
.hero-tip { font-size: var(--font-detail); color: var(--text-muted); line-height: 1.7; }
.hero-cta { margin-top: var(--space-section); }
.hero-share { margin-top: 12px; }
.hint .btn, .connection-panel .btn { width: 100%; min-height: var(--button-size); box-sizing: border-box; padding: 10px 16px; line-height: 1.5; }
.tab { width: auto; }

/* 榜单与局部刷新，保留数据的更新时间。 */
.pagination { margin: 12px var(--space-page) 0; text-align: center; }
.pagination .load-more { width: 100%; min-height: var(--touch-size); margin: 0; padding: 8px 12px; font-size: var(--font-detail); font-weight: 400; }
.pagination .inline-status { justify-content: center; }
.pagination-end, .pagination-error { font-size: var(--font-caption); color: var(--text-muted); line-height: 1.7; }
.pagination-error { margin-bottom: 8px; color: var(--danger); }
.board-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; margin: 12px var(--space-page) 0; font-size: var(--font-caption); color: var(--text-muted); line-height: 1.6; }
.board-refresh { margin: 0 var(--space-page); min-height: var(--touch-size); display: flex; align-items: center; }
.board-refresh .inline-status { padding: 8px 0; }
.refresh-action { margin-left: auto; }
.refresh-failed { width: 100%; display: flex; align-items: center; gap: 12px; }
.refresh-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.refresh-detail { margin-top: 2px; color: var(--text-muted); font-size: var(--font-caption); overflow-wrap: anywhere; }
.pk-hint { padding: 8px var(--space-page); color: var(--text-secondary); font-size: var(--font-caption); }

/* 汇总完整保留，置于排名和更新时间之后。窄屏整项换行，不拆数字。 */
.group-overview { margin: 0 var(--space-page); padding: 12px 0 var(--space-section); border-top: 1rpx solid var(--separator); border-bottom: 1rpx solid var(--separator); }
.overview-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: var(--font-heading); font-weight: 500; }
.overview-link { flex: none; display: flex; align-items: center; justify-content: center; width: auto; min-width: var(--touch-size); min-height: var(--touch-size); padding: 0 4px; margin: 0; box-sizing: border-box; background: transparent; color: var(--link); font-size: var(--font-detail); font-weight: 400; line-height: 1.5; border-radius: 0; }
.overview-metrics { display: flex; flex-wrap: wrap; gap: 16px 20px; margin: 12px 0 16px; }
.overview-metric { flex: 1 0 120px; min-width: 0; }
.overview-value { color: var(--amount); font-size: 22px; line-height: 1.4; font-weight: 400; font-variant-numeric: tabular-nums; white-space: nowrap; word-break: normal; }
.overview-unit { font-size: var(--font-detail); margin-left: 4px; }
.overview-label, .overview-note { font-size: var(--font-caption); color: var(--text-muted); line-height: 1.7; }
.overview-label { margin-top: 3px; }
.overview-preference { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; padding: 4px 0; font-size: var(--font-detail); line-height: 1.7; }
.overview-preference-label { color: var(--text-muted); flex: none; }
.overview-preference-value { flex: 1 1 120px; min-width: 0; text-align: right; overflow-wrap: anywhere; }
.overview-note { margin-top: 8px; }
.overview-status { margin-top: 8px; display: flex; align-items: center; gap: 8px; }
.overview-status > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }

/* 操作区与底部本人行。 */
.visibility-row { min-height: var(--touch-size); display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 12px var(--space-page) 0; padding: 8px 0; font-size: var(--font-detail); color: var(--text-secondary); }
.visibility-row switch { flex: none; min-height: var(--touch-size); display: flex; align-items: center; }
.board-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; margin: 4px var(--space-page) 0; }
.poster-style-label { display: flex; align-items: center; min-height: var(--touch-size); color: var(--link); font-size: var(--font-detail); }
.board-tools .text-action { width: auto; min-height: var(--touch-size); display: flex; align-items: center; justify-content: center; margin: 0; padding: 6px 0; box-sizing: border-box; background: transparent; color: var(--link); font-size: var(--font-detail); font-weight: 400; line-height: 1.5; text-align: left; border-radius: 0; }
.board-tools .other-groups { margin-left: auto; }
.share-note, .poster-note { margin: 4px var(--space-page) 0; color: var(--text-muted); font-size: var(--font-caption); line-height: 1.7; }
.poster-note { color: var(--danger); }
.dock-actions { padding: 0 var(--space-page) 12px; }
.share-dock .dock-share { width: 100%; min-height: var(--button-size); margin: 0; padding: 10px 16px; font-size: var(--font-body); line-height: 1.5; }

/* 加入、空态与错误状态。 */
.hint { padding: 40px var(--space-page); text-align: center; }
.hint-sm { padding: 32px var(--space-page); }
.hint.state-loading { flex-direction: column; }
.hint-title { font-size: var(--font-heading); font-weight: 500; line-height: 1.5; }
.hint-sub { font-size: var(--font-detail); color: var(--text-muted); line-height: 1.7; margin-top: 12px; }
.hint-sub.inline-error { color: var(--danger); }
.hint-link { display: flex; align-items: center; justify-content: center; width: auto; min-height: var(--touch-size); margin: 12px auto 0; padding: 0 12px; background: transparent; color: var(--link); font-size: var(--font-detail); font-weight: 400; line-height: 1.5; }
.hint-link::after { border: none; }
.join-prompt { text-align: left; padding: 32px var(--space-page); }
.join-prompt .inline-status { margin-top: 12px; }
.join-name { font-size: var(--font-heading); color: var(--text); margin-top: var(--space-section); overflow-wrap: anywhere; }
.hero-name, .join-name { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.name-prompt { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0; color: var(--text-secondary); font-size: var(--font-caption); }
.name-prompt .name-prompt-btn { flex: none; width: auto; min-width: var(--touch-size); min-height: var(--touch-size); margin: 0; padding: 0 8px; display: flex; align-items: center; justify-content: center; background: transparent; color: var(--link); font-size: var(--font-detail); font-weight: 400; line-height: 1.5; border-radius: 0; }
.name-prompt-btn::after { border: none; }
.name-input { margin-top: 16px; height: var(--button-size); padding: 0 12px; box-sizing: border-box; border: 1rpx solid var(--separator-strong); border-radius: 6px; background: var(--surface-muted); font-size: var(--font-detail); }
.name-ph { color: var(--text-muted); }
.source-note { margin: 0 0 12px; padding: 8px 0; border-bottom: 1rpx solid var(--separator); color: var(--text-secondary); font-size: var(--font-caption); line-height: 1.6; text-align: left; }
.profile-gate { padding: var(--space-section) var(--space-page); }
.profile-kicker { color: var(--text-muted); font-size: var(--font-caption); line-height: 1.6; overflow-wrap: anywhere; }
.profile-title { margin-top: 8px; font-size: var(--font-title); font-weight: 500; line-height: 1.4; }
.profile-intro { margin: 12px 0 var(--space-section); color: var(--text-secondary); font-size: var(--font-detail); line-height: 1.7; }
.profile-gate .note { margin-top: 12px; color: var(--text-muted); font-size: var(--font-caption); line-height: 1.7; }
.profile-gate .profile-exit { background: transparent; color: var(--link); width: auto; margin: 12px 0 0; padding: 0 8px; min-height: var(--touch-size); display: flex; align-items: center; justify-content: center; font-size: var(--font-detail); font-weight: 400; line-height: 1.5; border-radius: 0; }
.profile-exit::after { border: none; }
.rename-btn[disabled], .overview-link[disabled], .text-action[disabled] { background: transparent; color: var(--text-muted); }
.poster-canvas { position: fixed; left: -9999px; top: 0; width: 375px; height: 575px; }

@media (max-width: 340px) {
  .hero-top { gap: 4px; }
  .hero-top .overview-shortcut { font-size: var(--font-caption); }
  .overview-metric { flex-basis: 100%; }
  .overview-value { font-size: 20px; }
}
