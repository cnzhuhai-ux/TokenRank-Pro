<view class="page">
  <view class="tabs" aria-role="tablist" aria-label="趋势维度"><button class="tab {{dimension === 'tools' ? 'tab-active' : ''}}" aria-role="tab" aria-selected="{{dimension === 'tools'}}" aria-label="工具，{{dimension === 'tools' ? '已选中' : '未选中'}}" data-field="dimension" data-value="tools" bindtap="switchOption">工具</button><button class="tab {{dimension === 'models' ? 'tab-active' : ''}}" aria-role="tab" aria-selected="{{dimension === 'models'}}" aria-label="模型，{{dimension === 'models' ? '已选中' : '未选中'}}" data-field="dimension" data-value="models" bindtap="switchOption">模型</button></view>
  <view class="filter-bar">
    <picker mode="selector" range="{{periods}}" range-key="label" value="{{periodIndex}}" bindchange="pickPeriod" aria-label="选择统计周期，当前{{periods[periodIndex].label}}"><view class="filter-control"><text class="filter-label">周期</text><text class="filter-value">{{periods[periodIndex].label}}</text><text class="filter-chevron" aria-hidden="true">▾</text></view></picker>
    <picker mode="selector" range="{{metrics}}" range-key="label" value="{{metricIndex}}" bindchange="pickMetric" aria-label="选择排名口径，当前{{metrics[metricIndex].label}}"><view class="filter-control"><text class="filter-label">排名口径</text><text class="filter-value">{{metrics[metricIndex].label}}</text><text class="filter-chevron" aria-hidden="true">▾</text></view></picker>
  </view>
  <view wx:if="{{loading}}" class="state state-loading" aria-role="status"><view class="loading-indicator" aria-hidden="true"></view><text>正在读取趋势榜…</text></view>
  <view wx:elif="{{error}}" class="state">{{error}}<button class="btn btn-ghost" bindtap="refresh">重试</button></view>
  <block wx:elif="{{report}}">
    <view wx:if="{{refreshing}}" class="inline-status" aria-role="status"><view class="loading-indicator" aria-hidden="true"></view><text>正在更新趋势榜…</text></view>
    <view wx:elif="{{refreshError}}" class="inline-error" aria-role="alert"><text>{{refreshError}}</text><button bindtap="refresh" aria-label="重试更新趋势榜">重试</button></view>
    <view class="ranges"><view>{{report.from}} — {{report.to}}</view><view>对比 {{report.previous_from}} — {{report.previous_to}}</view><view class="sample">本期 {{report.summary.users}} 位公开用户 · 上期 {{report.previous_summary.users}} 位<text wx:if="{{report.creditsText}}"> · {{report.creditsText}} Credits</text></view></view>
    <view class="table-head"><text>{{dimension === 'tools' ? '工具' : '模型'}}</text><text>{{metric === 'users' ? '使用人数' : '含缓存总量'}}</text></view>
    <view wx:if="{{!report.entries.length}}" class="state">本期暂无可分类的{{dimension === 'tools' ? '工具' : '模型'}}记录。</view>
    <view wx:for="{{report.entries}}" wx:key="name" class="trend-row"><view class="trend-rank">{{item.rank}}</view><view class="trend-main"><view class="trend-heading"><text class="trend-name">{{item.name}}</text><view class="trend-value">{{metric === 'users' ? item.users : item.amount.value}}<text>{{metric === 'users' ? '人' : item.amount.unit}}</text></view></view><view class="track"><view style="width:{{item.width}}%;" class="fill"></view></view><view class="trend-meta"><text>{{metric === 'users' ? item.amount.value + ' ' + item.amount.unit + ' tokens' : item.users + ' 人使用'}}<text wx:if="{{item.creditsText}}"> · {{item.creditsText}} Credits</text> · 上期 {{item.previousValue}}</text><text class="{{item.changeClass}}">{{item.rankText}}</text></view></view></view>
    <view class="pagination"><view wx:if="{{moreError}}" class="error-note">{{moreError}}</view><button wx:if="{{report.has_more}}" class="text-button" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore || refreshing}}">加载更多 · {{report.entries.length}} / {{report.total}}</button><view wx:else>共 {{report.total}} 项</view></view>
    <view class="footnote">北京时间完整日区间，不含今日。使用人数按每项分别去重，同一人可使用多项。仅代表公开上报样本，按已上报明细统计；未分类用量不参与各项排名。上期位次按当前记录重算。</view>
    <button class="btn btn-primary share" open-type="share">转发趋势榜</button>
  </block>
</view>
