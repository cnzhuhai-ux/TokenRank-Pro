.page { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
.filter-control { flex-wrap: wrap; }
.filter-label { flex: none; }
.state { padding: 32px var(--space-page); color: var(--text-secondary); font-size: var(--font-detail); line-height: 1.8; }
.state .btn { margin-top: 16px; }
.ranges { padding: var(--space-page); font-size: var(--font-caption); line-height: 1.8; color: var(--text-secondary); overflow-wrap: anywhere; }
.ranges > view:first-child { color: var(--text); font-size: var(--font-detail); }
.sample { margin-top: 8px; }
.table-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding: 8px var(--space-page); background: var(--surface-muted); color: var(--text-muted); font-size: var(--font-caption); }
.trend-row { display: flex; gap: 12px; padding: 18px var(--space-page); border-bottom: 1rpx solid var(--separator); }
.trend-rank { width: 22px; flex: none; color: var(--text-secondary); font-size: var(--font-detail); line-height: 30px; }
.trend-main { min-width: 0; flex: 1; }
.trend-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; }
.trend-name { flex: 1 1 100px; min-width: 0; overflow-wrap: anywhere; font-size: var(--font-body); }
.trend-value { margin-left: auto; color: var(--amount); font-size: var(--font-title); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.trend-value text { margin-left: 4px; font-size: var(--font-detail); }
.track { height: 3px; background: var(--surface-muted); margin: 12px 0 8px; }
.fill { height: 3px; background: var(--amount); }
.trend-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 8px; color: var(--text-secondary); font-size: var(--font-caption); line-height: 1.7; }
.trend-meta > text:first-child { min-width: 0; overflow-wrap: anywhere; }
.trend-meta > text:last-child { margin-left: auto; }
.trend-meta .up { color: #21824E; }
.pagination { text-align: center; padding: 20px var(--space-page); font-size: var(--font-caption); color: var(--text-muted); }
.text-button { width: 100%; min-width: var(--touch-size); min-height: var(--touch-size); box-sizing: border-box; padding: 10px 0; margin: 0; background: transparent; color: var(--link); font-size: var(--font-detail); line-height: 24px; font-weight: 400; }
.text-button::after { border: none; }
.error-note { color: var(--danger); }
.footnote { margin: 0 var(--space-page); font-size: var(--font-caption); line-height: 1.8; color: var(--text-secondary); overflow-wrap: anywhere; }
.page .share { width: calc(100% - 32px); margin: 20px var(--space-page) 0; }
