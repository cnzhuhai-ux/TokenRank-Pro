<import src="../../templates/leaderboard.wxml" />
<view class="page">
  <view class="tabs" aria-role="tablist" aria-label="广场内容"><button class="tab {{mode === 'ranking' ? 'tab-active' : ''}}" aria-role="tab" aria-selected="{{mode === 'ranking'}}" data-key="ranking" bindtap="switchMode">总榜</button><button class="tab {{mode === 'tools' ? 'tab-active' : ''}}" aria-role="tab" aria-selected="{{mode === 'tools'}}" data-key="tools" bindtap="switchMode">工具</button><button class="tab {{mode === 'models' ? 'tab-active' : ''}}" aria-role="tab" aria-selected="{{mode === 'models'}}" data-key="models" bindtap="switchMode">模型</button></view>
  <view class="filter-bar">
    <picker range="{{periods}}" range-key="label" value="{{periodIndex}}" bindchange="pickPeriod" aria-label="选择统计周期，当前{{periods[periodIndex].label}}"><view class="filter-control"><text class="filter-label">周期</text><text class="filter-value">{{periods[periodIndex].label}}</text><text class="filter-chevron" aria-hidden="true">▾</text></view></picker>
    <view wx:if="{{mode === 'ranking'}}" class="filter-actions" aria-label="排名口径"><button class="filter-action {{metric !== 'credits' ? 'filter-action-selected' : ''}}" aria-pressed="{{metric !== 'credits'}}" data-key="tokens" bindtap="switchMetric">Token</button><button class="filter-action {{metric === 'credits' ? 'filter-action-selected' : ''}}" aria-pressed="{{metric === 'credits'}}" data-key="credits" bindtap="switchMetric">Credits</button></view>
  </view>
  <button class="trends-entry" bindtap="goTrends"><text>工具／模型趋势榜</text><text aria-hidden="true">›</text></button>
  <view wx:if="{{refreshing}}" class="inline-status" aria-role="status"><view class="loading-indicator" aria-hidden="true"></view><text>正在更新…</text></view>
  <view wx:elif="{{refreshError}}" class="inline-error" aria-role="alert"><text>{{refreshError}} · 当前显示上次结果</text><button bindtap="refresh">重试</button></view>
  <view wx:if="{{loading}}" class="hint state-loading" aria-role="status"><view class="loading-indicator" aria-hidden="true"></view><text>正在加载…</text></view>
  <view wx:elif="{{error}}" class="hint"><view class="hint-sub">{{error}}</view><button class="btn btn-ghost retry" bindtap="load">重新加载</button></view>
  <view wx:elif="{{mode !== 'ranking' && insights}}" class="insights">
    <view class="insight-heading"><text>{{mode === 'models' ? '模型' : '工具'}}使用分布</text><button class="insight-link" bindtap="goAnalysis">完整分析</button></view>
    <view class="insight-caption">{{insights.summary.users}} 位公开用户 · {{insights.categoryCount}} 种{{mode === 'models' ? '模型' : '工具'}}<text wx:if="{{insights.creditsText}}"> · {{insights.creditsText}} Credits</text></view>
    <usage-chart id="squareChart" mode="donut" segments="{{insights.segments}}" center-value="{{insights.centerValue}}" center-label="{{insights.centerLabel}}" />
    <view wx:if="{{!insights.items.length}}" class="hint-sub">本周期暂无明细。</view>
    <view wx:for="{{insights.items}}" wx:key="key" wx:if="{{index < 8}}" class="insight-row" data-name="{{item.unclassified ? '' : item.name}}" bindtap="goAnalysis"><view class="insight-row-head"><text class="insight-name">{{item.name}}</text><text class="insight-percent">{{item.percent}}%</text></view><view class="insight-track"><view style="width:{{item.percent}}%;background:{{item.color}};" class="insight-fill"></view></view><view class="insight-row-foot"><text>{{item.amount.value}} {{item.amount.unit}} tokens<text wx:if="{{item.creditsText}}"> · {{item.creditsText}} Credits</text></text><text wx:if="{{!item.unclassified}}">{{item.preferred_users}} 人常用 · {{item.users}} 人用过</text></view></view>
    <button class="btn btn-ghost insight-full" bindtap="goAnalysis">查看{{mode === 'models' ? '模型' : '工具'}}分析与常用用户</button><view class="insight-caption">常用按同期占比最高的一项统计；隐藏排名的用户不计入。</view>
  </view>
  <view wx:elif="{{!entries.length}}" class="hint"><view class="hint-title display">本周期暂无用量</view><view class="hint-sub">可以切换到其他周期。</view><view class="hint-link" bindtap="goConnect">接入电脑</view></view>
  <block wx:else>
    <view class="lb-table-head"><text>全站排名<text wx:if="{{total !== null}}"> · {{total}} 人</text></text><text>{{metric === 'credits' ? 'Credits 用量' : 'Token 用量'}}</text></view>
    <template is="leaderboard-row" wx:for="{{entries}}" wx:key="rank" data="{{item}}" />
    <view class="pagination">
      <view wx:if="{{moreError}}" class="pagination-error">{{moreError}}</view>
      <button wx:if="{{hasMore}}" class="load-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">{{loadingMore ? '正在加载…' : moreError ? '重新加载' : '加载更多'}}<text wx:if="{{!loadingMore}}"> · {{entries.length}} / {{total}}</text></button>
      <view wx:elif="{{total !== null}}" class="pagination-end">共 {{total}} 人</view>
    </view>
  </block>
  <view class="board-meta" wx:if="{{!loading && !error}}"><text>{{updated_fmt ? '榜单更新于 ' + updated_fmt : '等待首次上报'}}</text><text>含缓存 · 北京时间</text></view>
</view>
<view class="lb-own-dock" wx:if="{{mode === 'ranking' && (me || user) && !loading && !error}}"><template is="leaderboard-me" data="{{me, user, rankLabel: '我的全站排名', emptyLabel: user.rank_hidden ? '已关闭排名' : '本周期未上榜'}}" /></view>
<privacy-notice />
