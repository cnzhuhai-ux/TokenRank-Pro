<view class="page">
  <view wx:if="{{!tool}}" class="tabs" aria-role="tablist" aria-label="分析维度"><button class="tab {{dimension === 'tools' ? 'tab-active' : ''}}" aria-role="tab" aria-selected="{{dimension === 'tools'}}" aria-label="工具，{{dimension === 'tools' ? '已选中' : '未选中'}}" data-key="tools" bindtap="switchDimension">工具</button><button class="tab {{dimension === 'models' ? 'tab-active' : ''}}" aria-role="tab" aria-selected="{{dimension === 'models'}}" aria-label="模型，{{dimension === 'models' ? '已选中' : '未选中'}}" data-key="models" bindtap="switchDimension">模型</button></view>
  <view wx:else class="tool-heading"><text>{{tool}} · 模型</text><button class="text-button" bindtap="backToTools">返回工具</button></view>
  <view class="filter-bar">
    <picker mode="selector" range="{{periods}}" range-key="label" value="{{periodIndex}}" bindchange="pickPeriod" aria-label="选择统计周期，当前{{periods[periodIndex].label}}"><view class="filter-control"><text class="filter-label">周期</text><text class="filter-value">{{periods[periodIndex].label}}</text><text class="filter-chevron" aria-hidden="true">▾</text></view></picker>
  </view>
  <view wx:if="{{loading}}" class="state state-loading" aria-role="status"><view class="loading-indicator" aria-hidden="true"></view><text>正在读取分析数据…</text></view>
  <view wx:elif="{{error}}" class="state">{{error}}<button class="btn btn-ghost" bindtap="refresh">重试</button></view>
  <block wx:elif="{{report}}">
    <view wx:if="{{refreshing}}" class="inline-status" aria-role="status"><view class="loading-indicator" aria-hidden="true"></view><text>正在更新分析数据…</text></view>
    <view wx:elif="{{refreshError}}" class="inline-error" aria-role="alert"><text>{{refreshError}}</text><button bindtap="refresh" aria-label="重试更新分析数据">重试</button></view>
    <view class="overview"><view class="overview-label">{{scope === 'public' ? '公开用户用量' : '我的用量'}}{{tool ? ' · ' + tool : ''}} · 含缓存</view><view class="overview-value">{{report.amount.value}}<text>{{report.amount.unit}}</text></view><view class="overview-exact">{{report.exact}} tokens</view><view class="overview-stats"><text wx:if="{{scope === 'public'}}">{{report.summary.users}} 位公开用户</text><text wx:else>{{report.summary.active_days}} 天活跃</text><text>{{tool && report.association.unlinked_tokens > 0 ? '已关联 ' : ''}}{{report.categoryCount}} 种{{dimension === 'tools' ? '工具' : '模型'}}</text><text wx:if="{{report.summary.requests !== null}}">{{report.requestsText}} 次调用</text><text wx:if="{{report.creditsText}}">{{report.creditsText}} Credits</text></view><view class="range">{{report.from}} — {{report.to}} · 北京时间</view>
      <view wx:if="{{tool && report.association}}" class="association-note">模型明细已关联 {{report.association.percent}}%<text wx:if="{{report.association.unlinked_tokens > 0}}"> · 其余为未关联模型，需由{{scope === 'public' ? '对应用户' : '本机'}}更新同步器后补齐。</text></view>
    </view>
    <view class="filter-bar chart-filters">
      <view class="filter-control chart-control" aria-role="group" aria-label="图表类型">
        <text class="filter-label">图表</text>
        <view class="filter-actions"><button class="filter-action {{view === 'donut' ? 'filter-action-selected' : ''}}" aria-label="占比图，{{view === 'donut' ? '已选中' : '未选中'}}" data-key="donut" bindtap="switchView">占比</button><button class="filter-action {{view === 'trend' ? 'filter-action-selected' : ''}}" aria-label="趋势图，{{view === 'trend' ? '已选中' : '未选中'}}" data-key="trend" bindtap="switchView">趋势</button><button class="filter-action {{view === 'list' ? 'filter-action-selected' : ''}}" aria-label="用量明细，{{view === 'list' ? '已选中' : '未选中'}}" data-key="list" bindtap="switchView">明细</button></view>
      </view>
      <view wx:if="{{scope === 'public' && view === 'donut'}}" class="filter-control metric-control" aria-role="group" aria-label="占比口径">
        <text class="filter-label">占比口径</text>
        <view class="filter-actions"><button class="filter-action {{metric === 'tokens' ? 'filter-action-selected' : ''}}" aria-label="Token 占比，{{metric === 'tokens' ? '已选中' : '未选中'}}" data-key="tokens" bindtap="switchMetric">Token</button><button class="filter-action {{metric === 'people' ? 'filter-action-selected' : ''}}" aria-label="常用人数占比，{{metric === 'people' ? '已选中' : '未选中'}}" data-key="people" bindtap="switchMetric">常用人数</button></view>
      </view>
    </view>
    <view wx:if="{{focusName}}" class="focus"><text>{{focusName}}</text><button class="text-button" bindtap="clearFocus">查看全部</button></view>
    <block wx:if="{{view === 'donut'}}"><usage-chart mode="donut" segments="{{report.segments}}" center-value="{{report.centerValue}}" center-label="{{report.centerLabel}}" bindselect="chooseItem" /><view class="legend"><view wx:for="{{report.segments}}" wx:key="key" class="legend-row" data-name="{{item.name}}" bindtap="chooseItem"><view class="legend-name"><view class="dot" style="background:{{item.color}};"></view><text>{{item.name}}</text></view><text>{{item.chartPercent}}%</text></view></view></block>
    <block wx:elif="{{view === 'trend'}}"><view class="chart-caption">{{focusName || '总用量'}} · {{period === 'last_month' ? '上个月每日用量' : '最近 ' + report.trend_days + ' 天'}}</view><usage-chart mode="trend" daily="{{report.daily}}" bindpoint="selectDay" /><view class="day-detail">{{selectedDay ? selectedDay.day + ' · ' + selectedDay.exact + (selectedDay.value !== null ? ' tokens' : '') + (selectedDay.creditsText ? ' · ' + selectedDay.creditsText + ' Credits' : '') : '点折线查看当天数值'}}</view></block>
    <view wx:if="{{!report.creditsAvailable}}" class="note">该维度暂无积分分项（需新版同步器与 Trae 采集扩展上报），因此只显示 Token。</view>
    <view wx:if="{{report.has_overlap}}" class="note">部分上报明细有重叠，占比按明细总量计算。</view>
    <view class="section-title">{{view === 'list' ? '用量明细' : '各项用量'}}</view>
    <view wx:if="{{!report.items.length}}" class="empty">本周期暂无{{dimension === 'tools' ? '工具' : '模型'}}明细。</view>
    <view wx:for="{{report.items}}" wx:key="key" wx:if="{{index < visibleCount}}" class="detail-row {{item.selected ? 'detail-selected' : ''}}">
      <view class="detail-head" data-name="{{item.unclassified ? '' : item.name}}" bindtap="chooseItem"><view class="detail-name">{{item.name}}</view><view class="detail-number">{{item.amount.value}} {{item.amount.unit}}<text>{{item.percent}}%</text></view></view>
      <view class="track"><view class="fill" style="width:{{item.percent}}%;background:{{item.color}};"></view></view>
      <view class="detail-exact">{{item.exact}} tokens<text wx:if="{{item.creditsText}}"> · {{item.creditsText}} Credits</text></view>
      <view wx:if="{{!item.unclassified}}" class="detail-users"><text wx:if="{{scope === 'public'}}">{{item.preferred_users}} 人常用 · {{item.users}} 人用过</text><view class="detail-links"><button wx:if="{{dimension === 'tools'}}" class="text-button" data-name="{{item.name}}" bindtap="openToolModels">查看模型</button><button wx:if="{{scope === 'public'}}" class="text-button" data-name="{{item.name}}" bindtap="openAudience" disabled="{{gateBusy || audienceLoading}}">查看常用用户</button></view></view>
    </view>
    <button wx:if="{{report.items.length > visibleCount}}" class="text-button more" bindtap="moreItems">展开更多 · {{visibleCount}} / {{report.items.length}}</button>
    <view wx:if="{{audienceName}}" id="audience" class="audience-section"><view class="section-title">{{audienceName}} · 常用用户<text wx:if="{{audienceTotal !== null}}"> {{audienceTotal}} 人</text></view>
      <view wx:if="{{gateBusy || audienceLoading}}" class="note">正在读取…</view><view wx:if="{{audienceError}}" class="error-note">{{audienceError}}<button class="text-button" bindtap="openAudience">重试</button></view>
      <view wx:if="{{audienceTotal === 0}}" class="empty">本期暂无以此为主要{{dimension === 'tools' ? '工具' : '模型'}}的公开用户。</view>
      <view wx:for="{{audience}}" wx:key="rank" class="audience-row"><text class="audience-rank">{{item.rank}}</text><image wx:if="{{item.avatar_url && !item.avatarFailed}}" class="avatar" src="{{item.avatar_url}}" mode="aspectFill" data-index="{{index}}" binderror="audienceAvatarError" /><view wx:else class="avatar initial">{{item.initial}}</view><view class="audience-person"><view class="audience-name">{{item.nickname}}</view><view class="note">占{{tool ? '该工具' : '本人'}}用量 {{item.percent}}%</view></view><view class="audience-value">{{item.amount.value}}<text>{{item.amount.unit}}</text></view></view>
      <button wx:if="{{audienceHasMore}}" class="text-button more" bindtap="moreAudience" disabled="{{audienceLoading}}">加载更多 · {{audience.length}} / {{audienceTotal}}</button>
      <view class="note">只展示公开排名用户；常用取同期占比最高的一项，{{tool ? '未关联模型' : '未分类'}}占比最高时不推断偏好。右侧为所选{{dimension === 'tools' ? '工具' : '模型'}}用量。</view>
    </view>
    <view class="footnote">{{scope === 'public' ? '仅统计参与公开排名的用户。' : ''}}按已上报明细计算，未分类单列；未同步日期留空。{{updatedText ? '更新于 ' + updatedText : '等待同步'}}</view>
    <button wx:if="{{scope === 'mine' && dimension === 'tools' && report.summary.tokens > 0}}" class="btn btn-ghost bottom-entry" bindtap="goShareTools">分享工具偏好</button>
    <button wx:if="{{scope === 'mine' && !hasReported}}" class="btn btn-primary bottom-entry" bindtap="goConnect">接入电脑</button>
    <button wx:if="{{scope === 'public'}}" class="btn btn-ghost bottom-entry" bindtap="goMine">查看我的分析</button>
  </block>
</view>
