/* 微信列表式界面：白底、灰线、绿色操作、橙色用量。分享图片独立配色。 */
page {
  --surface: #FFFFFF;
  --surface-muted: #F7F7F7;
  --text: #191919;
  --text-secondary: #666666;
  --text-muted: #888888;
  --primary: #07C160;
  --primary-active: #06AD56;
  --link: #576B95;
  --amount: #D88A2D;
  --warning: #D88A2D;
  --danger: #FA5151;
  --danger-active: #E04545;
  --separator: #EDEDED;
  --separator-strong: #DDDDDD;
  --space-page: 16px;
  --space-section: 24px;
  --font-title: 22px;
  --font-heading: 17px;
  --font-body: 15px;
  --font-detail: 14px;
  --font-caption: 12px;
  --touch-size: 44px;
  --button-size: 48px;
  background: var(--surface);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 15px;
  line-height: 1.5;
}
.display { font-weight: 600; }
.num-font { font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; font-variant-numeric: tabular-nums; }

/* 页面内保留一组内容导航，周期和统计口径使用带标签的筛选。 */
.tabs { display: flex; gap: 0; padding: 0; background: var(--surface); border-bottom: 1rpx solid var(--separator); }
.tab { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; min-width: 0; min-height: var(--touch-size); box-sizing: border-box; padding: 0 4px; margin: 0; border-radius: 0; background: transparent; color: var(--text-secondary); font-size: var(--font-body); font-weight: 400; line-height: 1.5; }
.tab::after { content: none; border: none; }
.tab:active { background: var(--surface-muted); }
.tab-active { color: var(--text); font-weight: 500; }
.tab-active::after { content: ""; position: absolute; top: auto; right: auto; bottom: 0; left: 50%; width: 28px; height: 2px; margin-left: -14px; border-radius: 0; background: var(--primary); transform: none; }
.filter-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; padding: 4px var(--space-page); border-bottom: 1rpx solid var(--separator); }
.filter-bar picker { min-width: 0; }
.filter-control { display: flex; align-items: center; gap: 8px; min-height: var(--touch-size); box-sizing: border-box; color: var(--text); font-size: var(--font-detail); }
.filter-label { color: var(--text-secondary); font-size: var(--font-caption); }
.filter-value { font-weight: 500; }
.filter-chevron { color: var(--text-muted); font-size: 12px; }
.filter-actions { display: flex; flex-wrap: wrap; margin-left: auto; }
.filter-action { display: flex; align-items: center; justify-content: center; min-height: var(--touch-size); margin: 0; padding: 0 12px; border-radius: 0; background: transparent; color: var(--text-secondary); font-size: var(--font-detail); font-weight: 400; line-height: 1.5; }
.filter-action::after { border: none; }
.filter-action:active { background: var(--surface-muted); }
.filter-action-selected { color: var(--text); background: var(--surface-muted); border-radius: 4px; font-weight: 500; }
.section-divider { border-top: 1rpx solid var(--separator); margin: 0 var(--space-page); }

.btn { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: var(--button-size); padding: 10px 16px; border-radius: 6px; font-size: var(--font-heading); font-weight: 500; line-height: 1.5; text-align: center; letter-spacing: 0; }
.btn::after { border: none; }
.btn-primary { background: var(--primary); color: #FFFFFF; }
.btn-primary:active { background: var(--primary-active); }
.btn-ghost { background: #F2F2F2; color: var(--text); border: none; font-weight: 400; }
.btn-ghost:active { background: #EDEDED; }
.btn-danger { background: var(--danger); color: #FFFFFF; }
.btn-danger:active { background: var(--danger-active); }
.btn-ghost-danger { background: #F2F2F2; color: var(--danger); border: none; font-weight: 400; }
.btn[disabled] { background: #F2F2F2; color: #C8C8C8; border: none; }

.status-line { display: flex; align-items: center; gap: 6px; color: var(--text-secondary); font-size: 13px; line-height: 1.6; }
.status-dot { width: 5px; height: 5px; flex: none; border-radius: 50%; background: var(--primary); }
.status-pending .status-dot, .status-stale .status-dot, .status-error .status-dot, .status-stopped .status-dot { background: var(--danger); }
.rank-avatar { width: 40px; height: 40px; border-radius: 50%; flex: none; }
.rank-avatar-ph { display: flex; align-items: center; justify-content: center; background: var(--separator); color: var(--text-muted); font-size: 16px; font-weight: 400; }
.ph { color: var(--text-muted); }

.sk { background: #EDEDED; border-radius: 4px; animation: sk-breathe 1.4s ease-in-out infinite; }
@keyframes sk-breathe { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }
.export-canvas { position: fixed; left: -2000px; top: 0; width: 1000px; height: 800px; pointer-events: none; }
.data-share-actions { display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-end; gap:4px 16px; padding:4px 16px; border-bottom:1rpx solid var(--separator); }
.data-share-actions button { width:auto;min-width:0;flex:none;display:flex; align-items:center; justify-content:center; min-height:44px; margin:0; padding:6px 0; background:transparent; color:var(--link); font-size:14px; font-weight:400; line-height:1.5; }
.data-share-actions button::after { border:0; }
.data-share-actions button[disabled] { color:var(--text-muted); }
.data-share-actions>text { margin-right:auto; color:var(--text-muted); font-size:12px; }

.inline-status, .inline-error { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; min-height: var(--touch-size); box-sizing: border-box; padding: 8px var(--space-page); color: var(--text-secondary); background: var(--surface-muted); font-size: var(--font-caption); line-height: 1.7; }
.inline-error { color: var(--danger); }
.inline-error > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.inline-error button { display: flex; align-items: center; justify-content: center; min-width: var(--touch-size); min-height: var(--touch-size); margin: -8px 0 -8px auto; padding: 0 8px; background: transparent; color: var(--link); font-size: var(--font-detail); font-weight: 400; line-height: 1.5; }
.inline-error button::after { border: none; }
.loading-indicator { display: inline-block; flex: none; width: 14px; height: 14px; box-sizing: border-box; border: 2px solid var(--separator-strong); border-top-color: var(--primary); border-radius: 50%; animation: loading-rotate .8s linear infinite; }
.state-loading { display: flex; align-items: center; justify-content: center; gap: 10px; }
@keyframes loading-rotate { to { transform: rotate(360deg); } }
